				<nextDialogue><![CDATA[innoxia_quests_main_travelToHideout_hideout]]></nextDialogue>
			</response>
		</responses>
	</scene>
	
	<scene id="hideout">
		<preParsingEffects><![CDATA[
			[#pc.setRandomLocation(WORLD_TYPE_innoxia_shinrin_highlands_shiranuisTrap, PLACE_TYPE_innoxia_shinrin_highlands_shiranuisTrap_path)]
			[#meraxis.setLocation(WORLD_TYPE_innoxia_shinrin_highlands_shiranuisTrap, PLACE_TYPE_innoxia_shinrin_highlands_shiranuisTrap_hideout)]
			[#flags.setSavedLong('shiranuis_trap_fires_extinguished', 0)]
		]]></preParsingEffects>
