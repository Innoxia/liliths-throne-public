		<continuesDialogue>false</continuesDialogue>
		<travelDisabled>true</travelDisabled>
		<responses>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Alone]]></responseTitle>
				<responseTooltip><![CDATA[Suddenly finding yourself alone in this mist-clad landscape, you need to find the flames which Meraxis mentioned in order to break the youko's spell.]]></responseTooltip>
				<nextDialogue><![CDATA[default]]></nextDialogue>
			</response>
		</responses>
	</scene>
	
</dialogueNodes>
