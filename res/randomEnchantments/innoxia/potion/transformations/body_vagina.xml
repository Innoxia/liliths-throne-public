<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<potionEnchantment>
	<positiveEnchantment><![CDATA[false]]></positiveEnchantment>
	
	<spawnWeighting><![CDATA[
		100
	]]></spawnWeighting>
	
	<conditionalPreParsing><![CDATA[
		[#flags.setInt('extremeTF', RND.nextInt(100))]
		
		[#flags.setObject('potionSubspecies', util.static.randomItemFrom(subspecies.static.getCommonSubspecies(util.static.newArrayListOfValues(npc.getSubspecies()))))]
	]]></conditionalPreParsing>
	
	<name defaultPrepend="true"><![CDATA[the Pussy]]></name>
	
	<applicationSpeechStart replaceAll="false"><![CDATA[
		Ever wondered what it'd be like to have a [#flags.getObject('potionSubspecies').getFeralName(null)]'s pussy? Well, time to find out!
	]]></applicationSpeechStart>
	
	<applicationSpeechEnd replaceAll="false"><![CDATA[
		Now go and find some stud to break you in!
	]]></applicationSpeechEnd>
	
	<potionEffects>
		<conditional/>
		<effect><![CDATA[
			[#npc.setVaginaType(flags.getObject('potionSubspecies').getRace().getRacialBody().getVaginaType())]
		]]></effect>
	</potionEffects>
	
</potionEnchantment>
