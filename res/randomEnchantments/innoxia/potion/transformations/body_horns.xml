<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<potionEnchantment>
	<positiveEnchantment><![CDATA[false]]></positiveEnchantment>
	
	<spawnWeighting><![CDATA[
		#IF(npc.hasHorns() || npc.getBody().getAvailableHornTypes(false).isEmpty())
			0
		#ELSE
			100
		#ENDIF
	]]></spawnWeighting>
	
	<conditionalPreParsing/>
	
	<name defaultPrepend="true"><![CDATA[Horn-growth]]></name>
	
	<applicationSpeechStart replaceAll="false"><![CDATA[
		Time to get horny!
	]]></applicationSpeechStart>
	
	<applicationSpeechEnd replaceAll="false"><![CDATA[
		Those horns suit you!
	]]></applicationSpeechEnd>
	
	<potionEffects>
		<conditional/>
		<effect><![CDATA[
			[#npc.setHornType(util.static.randomItemFrom(npc.getBody().getAvailableHornTypes(false)))]
		]]></effect>
	</potionEffects>
	
</potionEnchantment>
