<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<potionEnchantment>
	<positiveEnchantment><![CDATA[false]]></positiveEnchantment>
	
	<spawnWeighting><![CDATA[
		#IF(npc.hasWings() || npc.getBody().getAvailableWingTypes().isEmpty() || npc.isAbleToFly())
			0
		#ELSE
			100
		#ENDIF
	]]></spawnWeighting>
	
	<conditionalPreParsing/>
	
	<name defaultPrepend="true"><![CDATA[Wing-growth]]></name>
	
	<applicationSpeechStart replaceAll="false"><![CDATA[
		Ever wished you could fly?
	]]></applicationSpeechStart>
	
	<applicationSpeechEnd replaceAll="false"><![CDATA[
		Cute wings!
	]]></applicationSpeechEnd>
	
	<potionEffects>
		<conditional/>
		<effect><![CDATA[
			[#npc.setWingType(util.static.randomItemFrom(npc.getBody().getAvailableWingTypes()))]
			#IF(npc.getWingType().allowsFlight() && npc.getWingSizeValue()<npc.getLegConfiguration().getMinimumWingSizeForFlight(npc.getBody()).getValue())
				[#npc.setWingSize(npc.getLegConfiguration().getMinimumWingSizeForFlight(npc.getBody()).getValue())]
			#ENDIF
		]]></effect>
	</potionEffects>
	
</potionEnchantment>
