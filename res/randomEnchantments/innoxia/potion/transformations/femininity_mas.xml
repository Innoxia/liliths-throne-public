<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<potionEnchantment>
	<positiveEnchantment><![CDATA[false]]></positiveEnchantment>
	
	<spawnWeighting><![CDATA[
		#IF(npc.getFemininity().getMedianFemininity()>FEMININITY_MASCULINE.getMaximumFemininity())
			100
		#ELSE
			0
		#ENDIF
	]]></spawnWeighting>
	
	<conditionalPreParsing><![CDATA[
		[#flags.setInt('extremeTF', RND.nextInt(100))]
	]]></conditionalPreParsing>
	
	<name defaultPrepend="true"><![CDATA[Masculinity]]></name>
	
	<applicationSpeechStart replaceAll="false"><![CDATA[
		You'd look better as a guy!
	]]></applicationSpeechStart>
	
	<applicationSpeechEnd replaceAll="false"><![CDATA[
		You look so hot!
	]]></applicationSpeechEnd>
	
	<!-- 66% chance of normal TF -->
	<potionEffects>
		<conditional><![CDATA[
			[#flags.getInt('extremeTF')<66]
		]]></conditional>
		<effect><![CDATA[
			[#npc.setFemininity(25)]
			
			#IF(npc.getHairRawLengthValue()>10)
				[#npc.setHairLength(10)]
			#ENDIF
			
		]]></effect>
	</potionEffects>
	
	<!-- 33% chance of extreme TF -->
	<potionEffects>
		<conditional><![CDATA[
			[#flags.getInt('extremeTF')>=66]
		]]></conditional>
		<effect><![CDATA[
			[#npc.setFemininity(5)]
			
			#IF(npc.getHairRawLengthValue()>5)
				[#npc.setHairLength(5)]
			#ENDIF
		]]></effect>
	</potionEffects>
	
	<potionEffects>
		<conditional/>
		<effect><![CDATA[
			#IF(npc.getAssSize().getValue()>ASS_SIZE_TWO_SMALL.getValue())
				[#npc.setAssSize(ASS_SIZE_TWO_SMALL)]
			#ENDIF
			#IF(npc.getHipSize().getValue()>HIP_SIZE_TWO_NARROW.getValue())
				[#npc.setHipSize(HIP_SIZE_TWO_NARROW)]
			#ENDIF
			
			#IF(npc.getBreastSize().getValue()>CUP_SIZE_FLAT.getValue())
				[#npc.setCupSize(CUP_SIZE_FLAT)]
			#ENDIF
		]]></effect>
	</potionEffects>
	
</potionEnchantment>
