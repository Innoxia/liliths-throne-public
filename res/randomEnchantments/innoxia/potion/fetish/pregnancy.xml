<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<potionEnchantment>
	<positiveEnchantment><![CDATA[false]]></positiveEnchantment>
	
	<spawnWeighting><![CDATA[
		#IF(npc.hasVagina() && !npc.hasFetish(FETISH_PREGNANCY) && !npc.isPregnant())
			100
		#ELSE
			0
		#ENDIF
	]]></spawnWeighting>
	
	<conditionalPreParsing/>
	
	<name defaultPrepend="true"><![CDATA[the Mother]]></name>
	
	<applicationSpeechStart replaceAll="false"><![CDATA[
		There's nothing better than being a mother!
	]]></applicationSpeechStart>
	
	<applicationSpeechEnd replaceAll="false"><![CDATA[
		Now go and get knocked up!
	]]></applicationSpeechEnd>
	
	<potionEffects>
		<conditional/>
		<effect><![CDATA[
			[#npc.addFetish(FETISH_PREGNANCY)]
		]]></effect>
	</potionEffects>
	
</potionEnchantment>
